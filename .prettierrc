{
    "plugins": ["prettier-plugin-astro"],
    "tabWidth": 4,
    "useTabs": false,
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "all",
    "overrides": [
        {
            "files": ["*.json", "*.jsonc", "*.yml", "*.yaml"],
            "options": { "tabWidth": 2 }
        }
    ]
}
