---
import type { Faq } from '../data/faqs';
import { slugify } from '../utils/slug';

interface Props {
    faq: Faq;
    /** Render expanded on page load */
    open?: boolean;
}

const { faq, open = false } = Astro.props;
const panelId = `faq-${slugify(faq.question)}`;
---
<li class="service-info d-flex flex-column align-items-center my-3">
    <div class="d-flex justify-content-between align-items-center vw-md-75 w-100 text-md-start text-center">
        <h3 class:list={['w-100 px-2', { hidden: open }]} data-collapse-host>
            <button
                type="button"
                class="service-cta w-100"
                aria-expanded={open ? 'true' : 'false'}
                aria-controls={panelId}
            >{faq.question}</button>
        </h3>
    </div>
    <div
        id={panelId}
        class:list={['card service-hidden w-100 vw-md-75 px-2 py-2 mx-md-5 mx-0 rounded-3 text-md-start text-center', { hidden: !open }]}
        tabindex="-1"
        inert={!open}
    >
        <h3 class="w-100">{faq.question}</h3>
        <Fragment set:html={faq.answerHtml} />
    </div>
</li>
