---
export interface NavLink {
    href: string;
    label: string;
}

interface Props {
    links?: NavLink[];
    /** Extra logo shown beside the PBF logo (used on the Biotapes page) */
    secondaryLogo?: { src: string; alt: string; width: number; height: number };
    /**
     * Show the full-screen intro nav at the top of the page (homepage only).
     * Otherwise the nav renders compact from the start and stays compact.
     */
    fullscreen?: boolean;
}

const defaultLinks: NavLink[] = [
    { href: '/', label: 'Home' },
    { href: '/services/', label: 'Pricing' },
    { href: '/about/', label: 'About Us' },
    // Biotapes is temporarily hidden (see src/pages/_biotapes.astro)
    // { href: '/biotapes/', label: 'Biotapes' },
    { href: '/contact/', label: 'Contact' },
];

const { links = defaultLinks, secondaryLogo, fullscreen = false } = Astro.props;
// Long link lists (Biotapes) wrap and use tighter vertical spacing
const isLong = links.length > 5;
---
<!-- NAV BAR -->
<nav class:list={['nav-bar w-100 vh-100 d-flex flex-nowrap flex-md-row flex-column align-items-center justify-content-center', { 'py-2': isLong, scrolled: !fullscreen }]} data-compact={fullscreen ? undefined : ''}>

    <!-- NAV LOGO -->
    <div class:list={['nav-logo w-100', { 'd-flex flex-row': secondaryLogo }]}>
        <img class:list={[secondaryLogo ? 'w-50' : 'w-100']} src="/assets/images/purposebuiltfilms-logo.svg" width="933" height="503" alt="Purpose Built Films">
        {secondaryLogo && <img class="w-25" src={secondaryLogo.src} width={secondaryLogo.width} height={secondaryLogo.height} alt={secondaryLogo.alt}>}
    </div>

    <!-- NAV LINKS -->
    <ul class:list={[
        'nav-links flex-md-column flex-row m-md-0 ps-md-1 ps-0 mw-25 w-100 d-flex align-items-center justify-content-md-start justify-content-around',
        isLong ? 'py-2 flex-wrap' : 'my-2',
    ]}>
        {links.map(({ href, label }) => (
            <li class:list={['nav rounded-2 px-2 border-box', isLong ? 'mx-md-3' : 'm-md-3']}>
                <a href={href}>{label}</a>
            </li>
        ))}
    </ul>
</nav>
