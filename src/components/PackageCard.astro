---
import { formatPrice, type Package } from '../data/packages';
import { slugify } from '../utils/slug';

interface Props {
    pkg: Package;
}

const { pkg } = Astro.props;
const panelId = `package-${slugify(pkg.name)}`;
---
<li class="vw-100 vw-md-75 card service-info d-flex flex-column align-items-center my-4 py-3 px-md-2">
    <div class="d-flex justify-content-between align-items-stretch align-items-md-start w-100 flex-md-row flex-column">
        <h3 class="w-md-25 flex-grow-0 accent-hover">{pkg.name}</h3>
        <div class="flex-grow-1 mx-3 text-md-start text-center">
            <p class="m-0 py-1 fs-5">{pkg.tagline}</p>
            <p class="m-0 p-0">{pkg.suitedFor}</p>
            <p class="m-0 py-2">
                <span class="accent">Deliverables:</span> <br />{pkg.deliverables}
            </p>
            <button type="button" class="service-cta cta-text" aria-expanded="false" aria-controls={panelId}>
                more info<span class="visually-hidden"> about the {pkg.name} package</span>...
            </button>
        </div>
    </div>
    <div id={panelId} class="service-hidden hidden vw-md-50 w-100 px-md-5 py-2 mx-5 mt-3 mt-md-0" tabindex="-1" inert>
        <p class="fs-5">Starting at {formatPrice(pkg.price)} +VAT</p>
        <p>{pkg.timeline}</p>
        <span class="accent fs-6">Includes:</span>
        <ul class="list-unstyled mb-0">
            {pkg.includes.map((item) => <li>{item}</li>)}
        </ul>
    </div>
</li>
