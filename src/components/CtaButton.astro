---
interface Props {
    href: string;
    /** Classes for the centring wrapper div */
    wrapperClass?: string;
}

const { href, wrapperClass = 'text-center m-3' } = Astro.props;
---
<div class={wrapperClass}>
    <a href={href}>
        <span class="btn-cta rounded-4 d-inline-block p-2 px-4 fs-5"><slot /></span>
    </a>
</div>
