---
import type { Service } from '../data/services';
import { slugify } from '../utils/slug';

interface Props {
    service: Service;
}

const { service } = Astro.props;
const panelId = `service-${slugify(service.title)}`;
---

<div class="d-flex flex-column flex-md-row align-items-center card service-info mx-auto vw-md-75 vw-100 my-4">
    <div class="col-12 col-md-4 py-2">
        <h3>{service.title}</h3>
        <img
            class="service-image img-fluid w-75 rounded-3 m-2"
            src={service.image}
            width={service.width}
            height={service.height}
            alt={service.alt}
            loading="lazy"
        />
    </div>
    <div class="col-12 col-md-8 mt-2 text-start px-4 text-center text-md-start">
        {service.intro}
        <span data-collapse-host>
            <br />
            <button type="button" class="service-cta cta-text" aria-expanded="false" aria-controls={panelId}>
                more info<span class="visually-hidden"> about {service.title}</span>...
            </button>
        </span>
        <div id={panelId} class="service-hidden hidden mt-3" tabindex="-1" inert>
            {service.details.map((paragraph) => (
                <p>{paragraph}</p>
            ))}
        </div>
    </div>
</div>
