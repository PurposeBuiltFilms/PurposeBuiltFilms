---
// Built to dist/404.html. Cloudflare serves it (with a 404 status) for any URL that
// doesn't match a page, e.g. the hidden /biotapes/ page.
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaButton from '../components/CtaButton.astro';

const meta = {
    title: 'Page not found | Purpose Built Films',
    description: "The page you're looking for doesn't exist or has moved.",
};
---
<BaseLayout meta={meta} noindex>
    <div id="main-content" class="main-content container-fluid pt-vh-10 px-md-0 px-3">
        <section class="card vw-md-50 vw-100 mx-a mt-5 py-5 px-4 text-center">
            <p class="accent fs-1 fw-bold mb-0">404</p>
            <h1 class="fs-2">Page not found</h1>
            <p class="mt-3">
                The page you're looking for doesn't exist or has moved.
                Try one of these instead:
            </p>
            <CtaButton href="/">Back to the homepage</CtaButton>
            <p class="mb-0">
                {/* Pricing is temporarily hidden (see src/pages/_services.astro)
                <a href="/services/">Pricing</a> · */}
                <a href="/about/">About us</a> ·
                <a href="/contact/">Contact</a>
            </p>
        </section>
    </div>
</BaseLayout>
