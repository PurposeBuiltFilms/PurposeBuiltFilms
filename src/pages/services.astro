---
import BaseLayout from '../layouts/BaseLayout.astro';
import JsonLd from '../components/JsonLd.astro';
import PackageCard from '../components/PackageCard.astro';
import { formatPrice, packages } from '../data/packages';
import CtaButton from '../components/CtaButton.astro';

const servicesSchema = {
    '@context': 'https://schema.org',
    '@graph': packages.map((pkg) => ({
        '@type': 'Service',
        name: pkg.schema.name,
        description: pkg.schema.description,
        offers: {
            '@type': 'Offer',
            priceCurrency: 'GBP',
            price: String(pkg.price),
            priceSpecification: {
                '@type': 'PriceSpecification',
                description: `Starting at ${formatPrice(pkg.price)} + VAT, ${pkg.schema.timeline}`,
            },
        },
        provider: {
            '@type': 'Organization',
            name: 'Purpose Built Films',
            url: 'https://purposebuiltfilms.com',
        },
    })),
};

const meta = {
    "title": "Pricing — Purpose Built Films | Rewilding & Nature Film Production, Bristol South West",
    "description": "Transparent rewilding and nature documentary film pricing from Bristol. Packages from £1,500 for short conservation films to £6,000+ for full series. Serving charities and land managers across the South West.",
    "ogTitle": "Pricing — Purpose Built Films | Rewilding & Nature Film Production, Bristol",
    "ogDescription": "Transparent rewilding and nature film pricing from £1,500. Short films, CEO branding, monthly content. Bristol-based, working across the South West and UK.",
    "twitterTitle": "Pricing — Rewilding & Nature Film Production | Purpose Built Films, Bristol",
    "twitterDescription": "Nature and rewilding documentary film pricing from £1,500. Bristol-based, South West England. Conservation charities, land managers, purpose-led brands."
};
---
<BaseLayout meta={meta}>
    <JsonLd slot="head" data={servicesSchema} />

    
    <!-- MAIN CONTENT STARTS -->
    <section class="vh-10"></section>
    <div id="main-content" class="main-content w-100 px-md-0 px-3 pb-0">

        <!-- SERVICES SECTION -->
        <section id="services-section" class="text-center collapse-holder mt-5">
            <h2 class="fs-1">Pricing</h2>
            <p class="vw-md-75 mx-a">
                Our film packages are tailored to suit any budget, providing cinematic-quality storytelling to amplify impact within your resources - CSR, marketing or otherwise.<br/>
                We manage every detail from <span class="accent">concept to delivery</span>, ensuring your narrative is crafted efficiently and effectively.
            </p>
            <p class="vw-md-75 mx-a">
                We offer competitive rates that deliver exceptional cinematic value. We’re committed to a collaboration that maximizes resources and brings your story to life - whatever your budget, we can find a way to tell your story.
            </p>

            <!-- PACKAGE OPTIONS -->
            <ul class="d-flex flex-column align-items-center p-1 p-md-0 border-box">

                {packages.map((pkg) => <PackageCard pkg={pkg} />)}

                <!-- PACKAGE ADD ONS -->
                <li class="vw-100 vw-md-75 card service-info d-flex flex-column align-items-center my-4 py-3 px-md-2">
                    <div class="d-flex justify-content-between align-items-stretch align-items-md-start w-100 flex-md-row flex-column">
                        <h3 class="w-md-25 flex-grow-0 accent-hover">Pollinators</h3>
                        <div class="w-md-75 flex-grow-1 mx-3 text-md-start text-center border-box ps-md-2">
                            <p class="m-0 py-1 fs-5">
                               Little extras that help your film travel further and reach the right habitats.
                            </p>
                            
                            <ul class="p-0">
                                <li class="d-inline-block py-2">
                                    <span class="accent">Additional Filming Days:</span> Add more filming days at £500 per day per camera operator.
                                </li>
                                <li class="d-inline-block py-2">
                                    <span class="accent">Extended Editing Sessions:</span> Available at an additional £500 per day.
                                </li>
                                <li class="d-inline-block py-2">
                                    <span class="accent">Custom Animations:</span> Priced upon request, tailored to specific narrative needs.
                                </li>
                            </ul>
                        </div>
                    </div>
                </li>
            </ul>

            <!-- CLIENT CTA -->
            <CtaButton href="/contact/" wrapperClass="text-center m-3 pb-5">Let us tell <em>your</em> story</CtaButton>

        </section>
    </div>

</BaseLayout>
