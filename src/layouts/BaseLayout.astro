---
import Nav, { type NavLink } from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

// Self-hosted fonts and site CSS, bundled by Astro (no third-party CDNs)
import '@fontsource-variable/funnel-display/wght.css';
import '@fontsource-variable/roboto-flex/opsz.css';
import '../styles/bootstrap.min.css';
import '../styles/style.css';
// Latin font files, preloaded so text renders without waiting on CSS to discover them
import funnelDisplayLatin from '@fontsource-variable/funnel-display/files/funnel-display-latin-wght-normal.woff2?url';
import robotoFlexLatin from '@fontsource-variable/roboto-flex/files/roboto-flex-latin-opsz-normal.woff2?url';

export interface Meta {
    title: string;
    description: string;
    /** Falls back to title/description when omitted */
    ogTitle?: string;
    ogDescription?: string;
    twitterTitle?: string;
    twitterDescription?: string;
}

interface Props {
    meta: Meta;
    navLinks?: NavLink[];
    navSecondaryLogo?: { src: string; alt: string; width: number; height: number };
    footerLegalNote?: string;
}

const { meta, navLinks, navSecondaryLogo, footerLegalNote } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
// TODO: og-image.jpg doesn't exist yet, so shared links (LinkedIn, Facebook, etc.) show no
// preview image. Add a 1200×630 still (e.g. a showreel frame) at
// public/assets/images/og-image.jpg; every page picks it up via og:image / twitter:image.
const ogImage = new URL('/assets/images/og-image.jpg', Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{meta.title}</title>
    <meta name="description" content={meta.description}>
    <link rel="canonical" href={canonical}>

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:url" content={canonical}>
    <meta property="og:title" content={meta.ogTitle ?? meta.title}>
    <meta property="og:description" content={meta.ogDescription ?? meta.description}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:site_name" content="Purpose Built Films">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={meta.twitterTitle ?? meta.ogTitle ?? meta.title}>
    <meta name="twitter:description" content={meta.twitterDescription ?? meta.ogDescription ?? meta.description}>
    <meta name="twitter:image" content={ogImage}>

    <link rel="preload" href={funnelDisplayLatin} as="font" type="font/woff2" crossorigin>
    <link rel="preload" href={robotoFlexLatin} as="font" type="font/woff2" crossorigin>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

    <!-- Page-specific head content, e.g. JSON-LD -->
    <slot name="head" />
</head>
<body class="parallax-wrapper">

    <Nav links={navLinks} secondaryLogo={navSecondaryLogo} />

    <div class="parallax-bg"></div>

    <slot />

    <!-- Shared site JS (defer: runs after parsing, never blocks rendering) -->
    <script is:inline src="/assets/js/main.js" defer></script>

    <Footer legalNote={footerLegalNote} />

    <!-- Page-specific content after the footer, e.g. modals and scripts -->
    <slot name="after-footer" />
</body>
</html>
