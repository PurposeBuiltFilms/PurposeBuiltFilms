# ── Dev tooling ───────────────────────────────────────────────────────────────
# Editor: share project settings, keep personal ones local
# (!.vscode/ re-includes the folder in case a global gitignore excludes it)
!.vscode/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
fiveserver.config.js
node_modules/

# ── Claude Code ───────────────────────────────────────────────────────────────
.claude/

# ── macOS ─────────────────────────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db

# ── Credentials / secrets (never commit) ──────────────────────────────────────
*.env
.env*
*.pem
*.key

# ── XAMPP / local server ──────────────────────────────────────────────────────
error_log
*.log

# ── Astro ──
dist/
.astro/
.legacy-snapshots/

# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
!.env.example
